-- Copy locally outside the repository; replace public-key placeholders only.
-- Private keys and passphrases stay outside worksheets and source control.
USE ROLE ACCOUNTADMIN;
CREATE USER IF NOT EXISTS HACKATHON_API_SERVICE
    TYPE = SERVICE
    DEFAULT_ROLE = HACKATHON_API
    DEFAULT_WAREHOUSE = HACKATHON_APP_WH
    DEFAULT_NAMESPACE = 'HACKATHON_DB.APP'
    RSA_PUBLIC_KEY = 'REPLACE_WITH_API_PUBLIC_KEY_BASE64_BODY';
GRANT ROLE HACKATHON_API TO USER HACKATHON_API_SERVICE;

CREATE USER IF NOT EXISTS HACKATHON_INGEST_SERVICE
    TYPE = SERVICE
    DEFAULT_ROLE = HACKATHON_INGEST
    DEFAULT_WAREHOUSE = HACKATHON_APP_WH
    DEFAULT_NAMESPACE = 'HACKATHON_DB.APP'
    RSA_PUBLIC_KEY = 'REPLACE_WITH_INGEST_PUBLIC_KEY_BASE64_BODY';
GRANT ROLE HACKATHON_INGEST TO USER HACKATHON_INGEST_SERVICE;
