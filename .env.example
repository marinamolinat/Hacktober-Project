# Signs the Flask login session cookie. Use a long random string.
SECRET_KEY=
# Leave blank to run with mock data
# mock | apify | instaloader (default: apify if APIFY_TOKEN is set, else mock)
SCRAPER=
# Posts fetched per account (pinned posts are skipped)
POSTS_PER_USER=8
# Instaloader: optional logged-in session (run `instaloader --login <user>` once)
IG_USERNAME=
IG_SESSIONFILE=
APIFY_TOKEN=
# Leave SNOWFLAKE_ACCOUNT blank to use a local SQLite copy of the schema (local.db)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=HACKATHON_API
SNOWFLAKE_WAREHOUSE=HACKATHON_APP_WH
SNOWFLAKE_DATABASE=HACKATHON_DB
SNOWFLAKE_SCHEMA=APP
# Cortex model for summaries/event extraction; blank = rule-based fallback
SNOWFLAKE_EXTRACT_MODEL=
