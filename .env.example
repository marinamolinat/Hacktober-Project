# Public Instagram ingestion; local data is never fabricated.
SCRAPER=instaloader
# Posts fetched per account (pinned posts are skipped)
POSTS_PER_USER=8
# Instaloader: optional logged-in session (run `instaloader --login <user>` once)
IG_USERNAME=
IG_SESSIONFILE=
APIFY_TOKEN=
# sqlite starts immediately; change to snowflake after provisioning the account.
STORAGE_BACKEND=sqlite
LOCAL_DATABASE_PATH=.local/feed.sqlite3
SNOWFLAKE_ACCOUNT=oidsfet-um90636
SNOWFLAKE_USER=OPATIENCE
SNOWFLAKE_AUTHENTICATOR=externalbrowser
SNOWFLAKE_ROLE=HACKATHON_API
SNOWFLAKE_INGEST_ROLE=HACKATHON_INGEST
# For deployed service login, register an encrypted RSA private key locally.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Only used when SNOWFLAKE_AUTHENTICATOR=snowflake.
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=HACKATHON_APP_WH
SNOWFLAKE_DATABASE=HACKATHON_DB
SNOWFLAKE_SCHEMA=APP
SNOWFLAKE_SEARCH_SERVICE=EVENT_SEARCH
SNOWFLAKE_AGENT=EVENT_ASSISTANT
# Set to a model enabled and checked in this account.
SNOWFLAKE_EXTRACT_MODEL=
SNOWFLAKE_SUMMARY_MODEL=
AI_BACKEND=cortex
# Set a long random value for persistent signed guest sessions.
FLASK_SECRET_KEY=
